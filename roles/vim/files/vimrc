" vim-plug
" default plugin directory:
"   - Vim (Linux/macOS): '~/.vim/plugged'
"   - Vim (Windows): '~/vimfiles/plugged'
"   - Neovim (Linux/macOS/Windows): stdpath('data') . '/plugged'
call plug#begin()

" colorscheme
Plug 'cocopon/iceberg.vim'                    " bluish colorscheme for Vim and Neovim
" lint/fix
Plug 'dense-analysis/ale'                     " asynchronous linting/fixing for vim and neovim
" syntax not provided by Vim runtime
Plug 'chazmcgarvey/vim-mermaid'               " Mermaid syntax
Plug 'elixir-editors/vim-elixir'              " Elixir syntax and indentation
Plug 'pearofducks/ansible-vim'                " Ansible syntax support
Plug 'aliou/bats.vim'                         " Bats syntax
Plug 'prisma/vim-prisma'                      " Prisma schema syntax
" Copilot
Plug 'github/copilot.vim'                     " GitHub Copilot

call plug#end()
packadd! editorconfig                        " EditorConfig support bundled with Vim

" indentation fallback; filetype plugins and EditorConfig can override per buffer
set autoindent
set expandtab
set shiftwidth=2
set softtabstop=-1

" colorscheme
set termguicolors
set background=dark
colorscheme iceberg

" whitespace visibility
" Tabs are unusual but valid, trailing spaces should be removed, and U+3000
" spaces should normally be replaced with ASCII spaces. Leading spaces are
" ordinary indentation and intentionally left unmarked.
set list listchars=tab:>-,trail:_
hi SpecialKey ctermbg=NONE ctermfg=110 guibg=NONE guifg=#84a0c6
hi TrailingWhitespace ctermbg=NONE ctermfg=203 guibg=NONE guifg=#e27878
hi ZenkakuSpace cterm=underline ctermul=216 gui=underline guisp=#e2a478
function! s:HighlightWhitespace() abort
  if exists('w:trailing_whitespace_match')
    silent! call matchdelete(w:trailing_whitespace_match)
  endif
  if exists('w:zenkaku_space_match')
    silent! call matchdelete(w:zenkaku_space_match)
  endif
  let w:trailing_whitespace_match = matchadd('TrailingWhitespace', ' \+$', 20)
  let w:zenkaku_space_match = matchadd('ZenkakuSpace', '\%u3000', 20)
endfunction
augroup HighlightWhitespace
  autocmd!
  autocmd VimEnter,BufWinEnter,WinEnter * call <SID>HighlightWhitespace()
augroup END

" ALE
function! TerragruntHclHandle(buffer, lines) abort
  let l:diagnostics = ale#util#FuzzyJSONDecode(a:lines, [])
  let l:output = []
  for l:diagnostic in l:diagnostics
    let l:range = get(l:diagnostic, 'range', {})
    let l:start = get(l:range, 'start', {})
    let l:end = get(l:range, 'end', {})
    let l:text = get(l:diagnostic, 'summary', 'Terragrunt HCL validation error')
    let l:detail = get(l:diagnostic, 'detail', '')
    if !empty(l:detail) && l:detail !=# l:text
      let l:text .= ': ' . l:detail
    endif
    call add(l:output, {
    \   'filename': get(l:range, 'filename', bufname(a:buffer)),
    \   'lnum': get(l:start, 'line', 1),
    \   'col': get(l:start, 'column', 1),
    \   'end_lnum': get(l:end, 'line', get(l:start, 'line', 1)),
    \   'end_col': get(l:end, 'column', get(l:start, 'column', 1)),
    \   'text': l:text,
    \   'type': get(l:diagnostic, 'severity', 'error') ==# 'warning' ? 'W' : 'E',
    \})
  endfor
  return l:output
endfunction

function! DockerBakeHandle(buffer, lines) abort
  let l:lines = filter(copy(a:lines), 'v:val !=# ""')
  return empty(l:lines) ? [] : [{
  \   'lnum': 1,
  \   'col': 1,
  \   'text': join(l:lines, ' '),
  \   'type': 'E',
  \}]
endfunction

function! TerragruntHclFormat(buffer) abort
  return {'command': 'terragrunt hcl fmt --stdin'}
endfunction

call ale#linter#Define('hcl', {
\   'name': 'terragrunt',
\   'executable': 'terragrunt',
\   'cwd': '%s:h',
\   'command': '%e hcl validate --json',
\   'callback': 'TerragruntHclHandle',
\   'lint_file': 1,
\})
call ale#linter#Define('hcl', {
\   'name': 'docker_bake',
\   'executable': 'docker',
\   'cwd': '%s:h',
\   'command': '%e buildx bake --progress=quiet --file %s --print',
\   'output_stream': 'stderr',
\   'callback': 'DockerBakeHandle',
\   'lint_file': 1,
\})
call ale#fix#registry#Add(
\   'terragrunt_hcl_fmt',
\   'TerragruntHclFormat',
\   ['hcl'],
\   'Format Terragrunt HCL with terragrunt hcl fmt',
\)

function! s:ConfigureHclAle() abort
  let l:filename = expand('%:t')
  if l:filename ==# 'terragrunt.hcl'
    let b:ale_linters = ['terragrunt']
    let b:ale_fixers = ['terragrunt_hcl_fmt']
  elseif l:filename =~# '^docker-bake\%\(\..*\)\?\.hcl$'
    let b:ale_linters = ['docker_bake']
    let b:ale_fixers = []
  endif
endfunction
augroup HclAle
  autocmd!
  autocmd FileType hcl call <SID>ConfigureHclAle()
augroup END

