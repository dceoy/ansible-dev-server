" vim-plug
" default plugin directory:
"   - Vim (Linux/macOS): '~/.vim/plugged'
"   - Vim (Windows): '~/vimfiles/plugged'
"   - Neovim (Linux/macOS/Windows): stdpath('data') . '/plugged'
call plug#begin()

" colorscheme
Plug 'cocopon/iceberg.vim'                    " bluish colorscheme for Vim and Neovim
" lint/fix
Plug 'dense-analysis/ale'                     " asynchronous linting/fixing for vim and neovim
" syntax not provided by Vim runtime
Plug 'chazmcgarvey/vim-mermaid'               " Mermaid syntax
Plug 'elixir-editors/vim-elixir'              " Elixir syntax and indentation
Plug 'pearofducks/ansible-vim'                " Ansible syntax support
Plug 'aliou/bats.vim'                         " Bats syntax
Plug 'prisma/vim-prisma'                      " Prisma schema syntax
" Copilot
Plug 'github/copilot.vim'                     " GitHub Copilot

call plug#end()
packadd! editorconfig                        " EditorConfig support bundled with Vim

" indentation fallback; filetype plugins and EditorConfig can override per buffer
set autoindent                              " take indent for new line from previous line
set expandtab                               " replace tabs with spaces
set shiftwidth=2                            " number of spaces to use for each indentation step
set softtabstop=-1                          " use shiftwidth for editing tabs
set whichwrap=b,s,h,l,<,>,[,],~             " allow backspace and cursor keys to cross line boundaries
set number                                  " show the line number in front of each line
set cursorline                              " highlight the screen line of the cursor
set cmdheight=2                             " number of screen lines to use for the command-line
set laststatus=2                            " always show the status line

" colorscheme
set termguicolors                           " enable true-color terminal rendering
set background=dark                         " use a dark background
colorscheme iceberg

" whitespace visibility
" Tabs are unusual but valid, trailing spaces should be removed, and U+3000
" spaces should normally be replaced with ASCII spaces. Leading spaces are
" ordinary indentation and intentionally left unmarked.
set list listchars=tab:>-,trail:_           " show tabs and trailing spaces
hi SpecialKey ctermbg=NONE ctermfg=110 guibg=NONE guifg=#84a0c6
hi TrailingWhitespace ctermbg=NONE ctermfg=203 guibg=NONE guifg=#e27878
hi ZenkakuSpace cterm=underline ctermul=216 gui=underline guisp=#e2a478
function! s:HighlightWhitespace() abort
  if exists('w:trailing_whitespace_match')
    silent! call matchdelete(w:trailing_whitespace_match)
  endif
  if exists('w:zenkaku_space_match')
    silent! call matchdelete(w:zenkaku_space_match)
  endif
  let w:trailing_whitespace_match = matchadd('TrailingWhitespace', ' \+$', 20)
  let w:zenkaku_space_match = matchadd('ZenkakuSpace', '\%u3000', 20)
endfunction
augroup HighlightWhitespace
  autocmd!
  autocmd VimEnter,BufWinEnter,WinEnter * call <SID>HighlightWhitespace()
augroup END

