{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^roles/.+\\/tasks/.+\\.ya?ml$/"],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>[^/]+/[^/]+)/(?<currentDigest>[0-9a-f]{40})/[^\\s\"']+"
      ],
      "currentValueTemplate": "master",
      "packageNameTemplate": "https://github.com/{{depName}}",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "Automatically merge minor and patch-level updates",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Require review for tool versions updated by regex managers",
      "matchManagers": ["custom.regex"],
      "automerge": false
    },
    {
      "description": "Require review for mise-managed tool versions",
      "matchManagers": ["mise"],
      "automerge": false
    }
  ]
}
